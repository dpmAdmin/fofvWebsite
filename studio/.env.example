# ---------------------------------------------------------------------------
# Copy to .env.local for local development. Set the same values in your host
# (Vercel > Settings > Environment Variables) for production.
# ---------------------------------------------------------------------------

# Your fal.ai API key, from https://fal.ai/dashboard/keys
# NEVER prefix this with NEXT_PUBLIC_ — it must stay server-side only.
FAL_KEY=

# Shared password used to enter the studio. Pick something long.
STUDIO_PASSWORD=

# Secret used to sign the session cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
